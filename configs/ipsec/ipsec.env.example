# Invoke-CSA-Lab8.ps1 generates real random keys in ipsec.env.
# Never commit configs/ipsec/ipsec.env.

CSA_HOME_WAN=192.168.62.42
CSA_COMPANY_WAN=192.168.62.253
CSA_HOME_NET=172.10.10.0/24
CSA_COMPANY_NET=172.30.0.0/16

CSA_H2C_SPI=0x00008001
CSA_C2H_SPI=0x00008002
CSA_H2C_REQID=8001
CSA_C2H_REQID=8002

CSA_H2C_AUTH_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CSA_H2C_ENC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CSA_C2H_AUTH_KEY=REPLACE_WITH_64_HEX_CHARACTERS
CSA_C2H_ENC_KEY=REPLACE_WITH_64_HEX_CHARACTERS
